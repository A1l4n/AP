# Firebase Configuration (REQUIRED)
# Get these from: https://console.firebase.google.com/
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# AssemblyAI for Transcription (Phase 3)
# Get API key from: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# OpenAI for AI Summaries (Phase 3)
# Get API key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key

# Microsoft Teams Integration (Phase 5)
# Register app at: https://portal.azure.com/
TEAMS_CLIENT_ID=your_teams_client_id
TEAMS_CLIENT_SECRET=your_teams_client_secret

# Zoom Integration (Phase 5)
# Create app at: https://marketplace.zoom.us/
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Google Meet Integration (Phase 4 & 5)
# Create credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
